# Development image with hot-reload
FROM golang:1.25.5

WORKDIR /app

# Install air for hot-reloading
RUN go install github.com/air-verse/air@latest

RUN go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@latest

# Copy source so go mod tidy can detect imports (volume overwrites at runtime)
COPY go.mod go.sum ./
RUN go mod download

# RUN go generate ./src/openAPI/generate.go #run manually

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]